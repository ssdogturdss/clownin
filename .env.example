# Clownin — Environment Variable Template
# Copy this file to .env and fill in the values before running the project.
# Never commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string — works with any standard Postgres instance
# (local, Docker, RDS, Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth / Security ──────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens (generate with: openssl rand -base64 48)
JWT_SECRET=

# Secret used to sign Express sessions (generate with: openssl rand -base64 48)
SESSION_SECRET=

# ─── Admin Access ─────────────────────────────────────────────────────────────
# Comma-separated list of usernames or email addresses that get admin access
# Example: alice,bob@example.com
ADMIN_USER_IDS=

# ─── AI Provider Keys (server-side) ───────────────────────────────────────────
# Direct OpenAI key — used as fallback when no per-user AI provider is configured
OPENAI_API_KEY=

# Replit AI Integrations proxy URLs and keys (auto-injected on Replit; set
# manually only when running outside Replit).
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ─── RevenueCat (subscription billing) ───────────────────────────────────────
# Server-side RevenueCat API key (from RevenueCat dashboard → API Keys)
REVENUECAT_API_KEY=

# The entitlement ID configured in RevenueCat that represents a Pro subscription
REVENUECAT_PRO_ENTITLEMENT_ID=pro

# Webhook secret for validating incoming RevenueCat webhooks
REVENUECAT_WEBHOOK_SECRET=
# Previous webhook secret — kept during secret rotation, optional
REVENUECAT_WEBHOOK_SECRET_PREV=

# RevenueCat sync tuning (all optional; defaults shown)
REVENUECAT_SYNC_CONCURRENCY=5
REVENUECAT_SYNC_MAX_RETRIES=3
REVENUECAT_SYNC_ERROR_RETRIES=2
SYNC_CATCHUP_DELAY_MS=500
# Optional Slack/Discord webhook URL for sync failure alerts
SYNC_ALERT_WEBHOOK_URL=

# ─── Mobile App (Expo public vars) ────────────────────────────────────────────
# Full URL of the deployed API server — used by the Expo app at build time
# Example: https://clownin.dev
EXPO_PUBLIC_API_URL=

# Public domain for the app (without protocol)
EXPO_PUBLIC_DOMAIN=

# RevenueCat public API keys (from RevenueCat dashboard → API Keys → Public)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the API server listens on (default: 8080)
PORT=8080

# Log verbosity: error | warn | info | debug (default: info)
LOG_LEVEL=info

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed request origins for the API server.
# Leave unset (or empty) to allow all origins — fine for local dev, but
# set explicitly in production to lock down cross-origin access.
# Example: CORS_ORIGIN=https://clownin.app,https://www.clownin.app
CORS_ORIGIN=
